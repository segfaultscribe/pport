---
layout: base.njk
---

<div class="parent">
    <div class="megas">
        
        <!-- Post Header Info -->
        <div class="post-header-meta">
            <span class="post-title-large {% if category == 'story' %}story-font{% endif %}">{{ title }}</span>
            <div class="post-subline">
                <span class="{% if category == 'story' %}story-font{% endif %}">{{ dateDisplay }}</span>
                <span>•</span>
                <span class="post-tag {% if category == 'story' %}story-font{% endif %}">{{ category }}</span>
            </div>
        </div>

        <!-- Markdown Content gets injected here -->
        <div class="post-content {% if category == 'story' %}story-font{% endif %}">
            {{ content | safe }}
        </div>

        <!-- Back to writings link -->
        <p style="margin-top: 3rem;">
            <a>←</a><a href="/writings/"> Back</a>
        </p>

    </div>
</div>